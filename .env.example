# Which LLM to use: ollama (free, local - default) | groq (free hosted API) | openai (any compatible API)
#                   | claude (Anthropic API) | fake (offline stub for tests)
LLM_PROVIDER=ollama

# --- Ollama (install from https://ollama.com, then: ollama pull qwen3:4b-instruct)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Set to false only for "thinking" models (qwen3:4b, deepseek-r1). Leave empty otherwise.
OLLAMA_THINK=

# --- Groq: free hosted API, no credit card (LLM_PROVIDER=groq). Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Tried in order; when one model's free daily quota runs out, the next one is used
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# --- Any other OpenAI-compatible API (LLM_PROVIDER=openai), e.g. OpenRouter or Gemini
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=

# --- Public demo (Hugging Face Space). Deploy with: python deploy/push_to_space.py --space <user>/studyrag
DEMO_MODE=0
HF_TOKEN=
REPO_URL=

# --- Claude (only if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Retrieval / storage
EMBED_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# vector | keyword | hybrid | hybrid+rerank (default; downloads a 450 MB re-ranker on first use)
RETRIEVAL_MODE=hybrid+rerank
RERANK_CANDIDATES=10
